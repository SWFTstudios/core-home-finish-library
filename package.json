{
  "name": "core-home-finish-library",
  "version": "0.1.0",
  "private": true,
  "description": "Core Home Render Portal — Finish Library and render request workflow",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "pages:deploy": "wrangler pages deploy public --project-name=core-home-finish-library --commit-dirty=true",
    "pages:deploy:main": "npm run pages:deploy -- --branch=main",
    "check": "wrangler check",
    "types": "wrangler types",
    "db:create": "wrangler d1 create render-portal-db",
    "db:migrate": "wrangler d1 execute render-portal-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute render-portal-db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute render-portal-db --local --file=./seed.sql",
    "db:seed": "wrangler d1 execute render-portal-db --remote --file=./seed.sql",
    "import:finishes": "node scripts/import-finish-library.mjs",
    "db:migrate:material": "wrangler d1 execute render-portal-db --file=./migrations/002_material_slug.sql",
    "db:migrate:material:local": "wrangler d1 execute render-portal-db --local --file=./migrations/002_material_slug.sql",
    "db:migrate:assets": "wrangler d1 execute render-portal-db --remote --file=./migrations/003_finish_assets.sql",
    "db:migrate:assets:local": "wrangler d1 execute render-portal-db --local --file=./migrations/003_finish_assets.sql",
    "db:seed:assets": "wrangler d1 execute render-portal-db --remote --file=./seed-finish-assets.sql",
    "db:seed:assets:local": "wrangler d1 execute render-portal-db --local --file=./seed-finish-assets.sql",
    "assets:inventory": "node scripts/inventory-finish-assets.mjs",
    "assets:import": "node scripts/import-finish-assets.mjs --replace-links",
    "assets:suggest": "node scripts/import-finish-assets.mjs --suggest-draft",
    "assets:validate": "node scripts/validate-finish-assets.mjs",
    "airtable:sync": "node scripts/export-d1-to-airtable.mjs",
    "airtable:sync:local": "node scripts/export-d1-to-airtable.mjs --local",
    "fetch:stitch-specs": "node scripts/fetch-stitch-specs.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "typescript": "^5.8.2",
    "wrangler": "^4.14.0",
    "xlsx": "^0.18.5"
  }
}
