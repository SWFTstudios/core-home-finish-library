{
  "name": "core-home-finish-library",
  "version": "0.1.0",
  "private": true,
  "description": "Core Home Render Portal — Finish Library and render request workflow",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "pages:deploy": "wrangler pages deploy public --project-name=core-home-finish-library --branch=main --commit-dirty=true",
    "check": "wrangler check",
    "types": "wrangler types",
    "db:create": "wrangler d1 create render-portal-db",
    "db:migrate": "wrangler d1 execute render-portal-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute render-portal-db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute render-portal-db --local --file=./seed.sql",
    "db:seed": "wrangler d1 execute render-portal-db --remote --file=./seed.sql",
    "import:finishes": "node scripts/import-finish-library.mjs",
    "renders:attach": "node scripts/attach-finish-renders.mjs",
    "render:colors": "node scripts/extract-finish-colors.mjs",
    "photos:prepare": "node scripts/prepare-ai-photos.mjs",
    "shells:export": "node scripts/export-product-shells.mjs",
    "test": "node --test \"test/*.test.mjs\" \"test/*.test.ts\"",
    "db:migrate:material": "wrangler d1 execute render-portal-db --file=./migrations/002_material_slug.sql",
    "db:migrate:material:local": "wrangler d1 execute render-portal-db --local --file=./migrations/002_material_slug.sql",
    "db:migrate:auth": "wrangler d1 execute render-portal-db --remote --file=./migrations/003_auth.sql",
    "db:migrate:auth:local": "wrangler d1 execute render-portal-db --local --file=./migrations/003_auth.sql",
    "db:migrate:access": "wrangler d1 execute render-portal-db --remote --file=./migrations/004_request_access.sql",
    "db:migrate:access:local": "wrangler d1 execute render-portal-db --local --file=./migrations/004_request_access.sql",
    "fetch:stitch-specs": "node scripts/fetch-stitch-specs.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "sharp": "^0.35.5",
    "typescript": "^5.8.2",
    "wrangler": "^4.14.0",
    "xlsx": "^0.18.5"
  }
}
